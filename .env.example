# Database
DATABASE_URL=postgresql+asyncpg://tennis:tennis@db:5432/tennis_match

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# JWT & Auth
SECRET_KEY=your-secret-key-change-in-production
TELEGRAM_SECRET_KEY=your-telegram-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# App
DEBUG=false
APP_ENV=production
APP_NAME=TennisMatch

# API
API_V1_PREFIX=/api/v1

# Telegram Webhook (set to your Railway public URL in production; leave empty for local polling)
WEBHOOK_URL=https://your-app.railway.app
